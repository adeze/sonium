# Full standalone QA binary sweep. The manifest is the source of truth so new
# BLR, room, speaker, pipeline, and solver targets cannot be silently omitted.
qa-full: _qa-run-all

_qa-run-all:
    #!/usr/bin/env python3
    import pathlib
    import subprocess
    import sys
    import tomllib

    root = pathlib.Path("{{justfile_directory()}}").parent.parent
    manifest = tomllib.loads((root / "crates/sonium-qa/Cargo.toml").read_text())
    failures = []
    passes = []
    targets = sorted(manifest["bin"], key=lambda target: target["name"])
    for target in targets:
        name = target["name"]
        timeout = "900" if name.startswith("qa-bem-") else "300"
        features = target.get("required-features", [])
        if features:
            cmd = ["just", "_qa-run-features", name, timeout, ",".join(features)]
        else:
            cmd = ["just", "_qa-run", name, timeout]
        if subprocess.run(cmd, cwd=root).returncode == 0:
            passes.append(name)
        else:
            failures.append(name)

    print(f"\nqa-full summary: {len(passes)} passed, {len(failures)} failed")
    for name in failures:
        print(f"  FAIL: {name}")
    if failures:
        sys.exit(1)

qa-solvers:
    #!/usr/bin/env bash
    set -uo pipefail
    failures=()
    passes=()
    for t in {{justfile_directory()}}/bin/solvers_*.rs; do
        tname="qa-$(basename "${t}" .rs | tr '_' '-')"
        if just _qa-run "${tname}" 300; then
            passes+=("${tname}")
        else
            failures+=("${tname}")
        fi
    done
    echo
    echo "qa-solvers summary: ${#passes[@]} passed, ${#failures[@]} failed"
    if [ "${#failures[@]}" -gt 0 ]; then
        for f in "${failures[@]}"; do echo "  FAIL: ${f}"; done
        exit 1
    fi

