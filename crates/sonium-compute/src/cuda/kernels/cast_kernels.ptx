    add.u64 %rd6, %rd1, %rd5;
    ld.global.f64 %fd1, [%rd6];
    cvt.rn.f32.f64 %f1, %fd1;
    mul.wide.u32 %rd5, %r4, 4;
    add.u64 %rd7, %rd2, %rd5;
    st.global.f32 [%rd7], %f1;

