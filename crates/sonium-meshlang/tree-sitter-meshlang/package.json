{
  "name": "tree-sitter-meshlang",
  "version": "0.1.0",
  "description": "Tree-sitter grammar for MeshLang mesh description language",
  "main": "bindings/node",
  "keywords": ["parser", "tree-sitter", "meshlang", "mesh", "gmsh"],
  "license": "MIT OR Apache-2.0",
  "dependencies": {
    "nan": "^2.17.0"
  },
  "devDependencies": {
    "tree-sitter-cli": "^0.20.8"
  },
  "scripts": {
    "build": "tree-sitter generate",
    "test": "tree-sitter test"
  },
  "tree-sitter": [
    {
      "scope": "source.meshlang",
      "file-types": ["mlg"],
      "highlights": "queries/highlights.scm",
      "injection-regex": "meshlang"
    }
  ]
}
